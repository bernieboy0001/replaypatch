# OpenAI (GPT-5.5) credentials — required for live analysis.
# Without it, the app runs in DEMO_MODE with a canned pipeline result.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Where to run the generated Playwright test (file path or http URL).
# Defaults to the bundled sample buggy app.
TARGET_URL=file://./sample-app/index.html

# Local folder the patcher is allowed to read/write when fixing source.
TARGET_REPO=./sample-app

# GitHub token (optional) — when set, ReplayPatch opens a PR with the fix.
GITHUB_TOKEN=
GITHUB_REPO=

# ── 0G Integration (required for on-chain proofs) ──────────────────────────
# RPC endpoint for 0G Chain (mainnet: https://evm.0g.ai)
OG_RPC_URL=https://evm.0g.ai
OG_CHAIN_ID=12345

# Wallet private key — used to deploy the contract and write QA events.
# NEVER commit this to a public repo.
OG_PRIVATE_KEY=

# QAVerifier contract address on 0G mainnet (set after deployment).
OG_CONTRACT_ADDRESS=

# 0G Explorer base URL (for linking to txs).
OG_EXPLORER=https://explorer.0g.ai
