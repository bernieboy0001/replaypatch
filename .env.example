# OpenAI (GPT-5.5) credentials — required for live analysis.
# Without it, the app runs in DEMO_MODE with a canned pipeline result.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Where to run the generated Playwright test (file path or http URL).
# Defaults to the bundled sample buggy app.
TARGET_URL=file://./sample-app/index.html

# Local folder the patcher is allowed to read/write when fixing source.
TARGET_REPO=./sample-app

# GitHub token (optional) — when set, ReplayPatch opens a PR with the fix.
GITHUB_TOKEN=
GITHUB_REPO=
