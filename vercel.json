{
  "services": {
    "replaypatch": {
      "root": ".",
      "framework": "nextjs",
      "buildCommand": "npm install --include=dev && npm rebuild ffmpeg-static && npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "replaypatch"
      }
    }
  ]
}
